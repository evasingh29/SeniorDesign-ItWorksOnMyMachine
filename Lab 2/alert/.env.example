# Copy to .env; never commit credentials.
ALERT_CHANNELS=smtp
# SERIAL_PORT=/dev/cu.usbmodem12301
# ALERT_LOG=alert.log
# Optional local output alongside email: ALERT_CHANNELS=smtp,console
# Offline simulation: ALERT_CHANNELS=console python main.py --simulate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=your-address@gmail.com
SMTP_TO=recipient@example.com
SMTP_USERNAME=your-address@gmail.com
# Google App Password only (16 characters, remove display spaces). NEVER your normal password.
SMTP_PASSWORD=
# Optional push: add ntfy to ALERT_CHANNELS. Use a private topic/token.
NTFY_URL=https://ntfy.sh/replace-with-your-private-topic
NTFY_TOKEN=
